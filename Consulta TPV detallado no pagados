SET @fecha_inicio = '2026-07-01';
SET @fecha_fin    = '2026-07-31';

SELECT
    idcliente,
    nombre_completo,
    folio_notapago,
    producto,
    categoria_negocio,
    subcategoria_negocio,
    unidad_negocio,
    subunidad_negocio,
    fecha_adeudo,
    fecha_pago,
    monto_bruto,
    descuento_aplicado,
    monto_neto
FROM (

    /* PENDIENTES - COMANDA */
    SELECT
        CASE
            WHEN c.id_invitado IS NOT NULL
                THEN CONCAT('INV-', i.id)
            ELSE CAST(uc.idusuarios AS CHAR)
        END AS idcliente,

        CASE
            WHEN c.id_invitado IS NOT NULL
                THEN CONCAT(i.nombre, ' (invitado)')
            ELSE CONCAT_WS(' ', uc.nombre, uc.paterno, uc.materno)
        END AS nombre_completo,

        NULL AS folio_notapago,
        CONCAT('COMANDA #', c.folio) AS producto,
        NULL AS categoria_negocio,
        NULL AS subcategoria_negocio,
        'TPV' AS unidad_negocio,
        'COMANDAS' AS subunidad_negocio,
        DATE(c.creado_en) AS fecha_adeudo,
        NULL AS fecha_pago,
        SUM(ci.costototal) AS monto_bruto,
        NULL AS descuento_aplicado,
        NULL AS monto_neto,

        c.id_comanda AS orden_comanda,
        0 AS nivel_fila

    FROM comandas AS c

    INNER JOIN comanda_item AS ci
        ON ci.id_comanda = c.id_comanda
        AND ci.estatus = 1

    LEFT JOIN usuarios AS u
        ON u.idusuarios = c.id_usuario

    LEFT JOIN bdcentralwon.usuarios_central AS uc
        ON uc.idusuarios = u.idusuarios

    LEFT JOIN invitados AS i
        ON i.id = c.id_invitado

    WHERE c.estado_pago IN ('pendiente', 'cobrando')
      AND c.creado_en >= CONCAT(@fecha_inicio, ' 00:00:00')
      AND c.creado_en < DATE_ADD(@fecha_fin, INTERVAL 1 DAY)

    GROUP BY
        c.id_comanda,
        c.folio,
        DATE(c.creado_en),
        c.id_invitado,
        i.id,
        i.nombre,
        uc.idusuarios,
        uc.nombre,
        uc.paterno,
        uc.materno

    UNION ALL

    /* PENDIENTES - ITEMS DE COMANDA */
    SELECT
        CASE
            WHEN c.id_invitado IS NOT NULL
                THEN CONCAT('INV-', i.id)
            ELSE CAST(uc.idusuarios AS CHAR)
        END AS idcliente,

        CASE
            WHEN c.id_invitado IS NOT NULL
                THEN CONCAT(i.nombre, ' (invitado)')
            ELSE CONCAT_WS(' ', uc.nombre, uc.paterno, uc.materno)
        END AS nombre_completo,

        NULL AS folio_notapago,
        CONCAT('  └─ ', ci.nombrepaquete, ' x', ci.cantidad) AS producto,
        cat.nombre AS categoria_negocio,
        csn.nombre AS subcategoria_negocio,
        'TPV' AS unidad_negocio,
        csu.nombre AS subunidad_negocio,
        DATE(c.creado_en) AS fecha_adeudo,
        NULL AS fecha_pago,
        ci.costototal AS monto_bruto,
        NULL AS descuento_aplicado,
        NULL AS monto_neto,

        c.id_comanda AS orden_comanda,
        1 AS nivel_fila

    FROM comandas AS c

    INNER JOIN comanda_item AS ci
        ON ci.id_comanda = c.id_comanda
        AND ci.estatus = 1

    LEFT JOIN usuarios AS u
        ON u.idusuarios = c.id_usuario

    LEFT JOIN bdcentralwon.usuarios_central AS uc
        ON uc.idusuarios = u.idusuarios

    LEFT JOIN invitados AS i
        ON i.id = c.id_invitado

    LEFT JOIN paquetes AS paq
        ON paq.idpaquete = ci.idpaquete

    LEFT JOIN categoriapaquete AS cp
        ON cp.idcategoriapaquete = paq.idcategoriapaquete

    LEFT JOIN cps_subunidad_negocio AS csu
        ON csu.id = cp.id_subunidad_negocio

    LEFT JOIN cps_unidad_negocio AS cun
        ON cun.id = csu.id_unidad_negocio

    LEFT JOIN cps_subcategoria_negocio AS csn
        ON csn.id = cun.id_subcategoria_negocio

    LEFT JOIN cps_categoria_negocio AS cat
        ON cat.id = csn.id_categoria_negocio

    WHERE c.estado_pago IN ('pendiente', 'cobrando')
      AND c.creado_en >= CONCAT(@fecha_inicio, ' 00:00:00')
      AND c.creado_en < DATE_ADD(@fecha_fin, INTERVAL 1 DAY)

) AS tpv

ORDER BY
    orden_comanda,
    nivel_fila,
    fecha_pago,
    fecha_adeudo;